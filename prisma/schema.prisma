generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Source {
  id            String       @id @default(cuid())
  name          String
  url           String       @unique
  feedUrl       String?
  type          String       @default("RSS")
  enabled       Boolean      @default(true)
  lastScannedAt DateTime?
  lastScanStatus String?
  lastScanMessage String?
  lastScanNewItems Int       @default(0)
  lastSuccessfulScanAt DateTime?
  articles      Article[]
  submissions   Submission[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Article {
  id                String           @id @default(cuid())
  slug              String           @unique
  title             String
  summary           String
  fullSummary       String
  coverImage        String?
  sourceUrl         String
  sourceName        String
  sourcePublishedAt DateTime?
  publishedAt       DateTime?
  category          String           @default("NEWS")
  status            String           @default("DRAFT")
  importanceScore   Int              @default(5)
  artistryScore     Int              @default(5)
  humorScore        Int              @default(3)
  scoreExplanation  String
  aiComment         String
  sourceId          String?
  submissionId      String?          @unique
  source            Source?          @relation(fields: [sourceId], references: [id])
  submission        Submission?      @relation(fields: [submissionId], references: [id])
  tags              ArticleTag[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([status, sourcePublishedAt])
  @@index([status, publishedAt])
  @@index([category, status])
}

model Submission {
  id          String           @id @default(cuid())
  url         String
  nickname    String
  note        String?
  status      String   @default("PENDING")
  rawTitle    String?
  rawDescription String?
  rawExcerpt  String?
  rawImage    String?
  rawPublishedAt DateTime?
  rawAuthor   String?
  canonicalUrl String?
  scrapeStatus String?
  scrapeMessage String?
  scrapedAt   DateTime?
  errorMessage String?
  discoveredAt DateTime?
  sourceId    String?
  source      Source?          @relation(fields: [sourceId], references: [id])
  article     Article?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([url])
  @@index([sourceId, discoveredAt])
}

model Tag {
  id        String       @id @default(cuid())
  name      String       @unique
  slug      String       @unique
  articles  ArticleTag[]
  createdAt DateTime     @default(now())
}

model ArticleTag {
  articleId String
  tagId     String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
}
